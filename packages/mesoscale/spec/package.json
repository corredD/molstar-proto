{
  "name": "@molstar/meso-spec",
  "version": "6.0.0-dev.0",
  "private": true,
  "type": "module",
  "description": "MesoViewSpec prototype: a declarative format for mesoscale scenes, its IR, runtime and resolvers (no Mol* imports)",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "sideEffects": false,
  "exports": {
    "./format": {
      "molstar-src": "./src/format/index.ts",
      "types": "./lib/format/index.d.ts",
      "import": "./lib/format/index.js"
    },
    "./builder": {
      "molstar-src": "./src/builder/index.ts",
      "types": "./lib/builder/index.d.ts",
      "import": "./lib/builder/index.js"
    },
    "./ir": {
      "molstar-src": "./src/ir/index.ts",
      "types": "./lib/ir/index.d.ts",
      "import": "./lib/ir/index.js"
    },
    "./runtime": {
      "molstar-src": "./src/runtime/index.ts",
      "types": "./lib/runtime/index.d.ts",
      "import": "./lib/runtime/index.js"
    },
    "./resolvers": {
      "molstar-src": "./src/resolvers/index.ts",
      "types": "./lib/resolvers/index.d.ts",
      "import": "./lib/resolvers/index.js"
    },
    "./examples": {
      "molstar-src": "./src/examples/index.ts",
      "types": "./lib/examples/index.d.ts",
      "import": "./lib/examples/index.js"
    },
    "./cli": {
      "molstar-src": "./src/cli/index.ts",
      "types": "./lib/cli/index.d.ts",
      "import": "./lib/cli/index.js"
    },
    "./_test/*": null
  },
  "files": [
    "lib",
    "src",
    "!**/_test/**",
    "!**/*.tsbuildinfo"
  ],
  "bin": {
    "meso-validate": "./lib/cli/meso-validate.js",
    "meso-compile": "./lib/cli/meso-compile.js",
    "meso-print": "./lib/cli/meso-print.js",
    "meso-trace": "./lib/cli/meso-trace.js",
    "meso-query": "./lib/cli/meso-query.js"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "spec": "node --conditions=molstar-src --experimental-transform-types --import ./scripts/ts-resolve.ts scripts/spec.ts",
    "test:scaling": "vitest run --config vitest.scaling.config.ts",
    "meso-validate": "tsc -b && cd .. && node spec/lib/cli/meso-validate.js",
    "meso-compile": "tsc -b && cd .. && node spec/lib/cli/meso-compile.js",
    "meso-print": "tsc -b && cd .. && node spec/lib/cli/meso-print.js",
    "meso-trace": "tsc -b && cd .. && node spec/lib/cli/meso-trace.js",
    "meso-query": "tsc -b && cd .. && node spec/lib/cli/meso-query.js"
  },
  "dependencies": {
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@molstar/test-harness": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/typescript6": "catalog:",
    "typescript": "catalog:"
  }
}
