{
  "name": "@molstar/meso-spec",
  "version": "6.0.0-dev.0",
  "private": true,
  "type": "module",
  "description": "MesoViewSpec prototype: a declarative format for mesoscale scenes, its IR, runtime and resolvers (no Mol* imports)",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    "./*": {
      "molstar-src": "./src/*.ts",
      "types": "./lib/*.d.ts",
      "import": "./lib/*.js"
    },
    ".": {
      "molstar-src": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./_test/*": null
  },
  "files": [
    "lib",
    "src",
    "!**/_test/**",
    "!**/*.tsbuildinfo"
  ],
  "bin": {
    "meso-validate": "./lib/cli/meso-validate.js",
    "meso-compile": "./lib/cli/meso-compile.js",
    "meso-print": "./lib/cli/meso-print.js",
    "meso-trace": "./lib/cli/meso-trace.js",
    "meso-query": "./lib/cli/meso-query.js"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "spec": "node --conditions=molstar-src --experimental-transform-types --import ./scripts/ts-resolve.ts scripts/spec.ts",
    "test:scaling": "vitest run --config vitest.scaling.config.ts",
    "meso-validate": "tsc -b && cd .. && node spec/lib/cli/meso-validate.js",
    "meso-compile": "tsc -b && cd .. && node spec/lib/cli/meso-compile.js --base spec/src",
    "meso-print": "tsc -b && cd .. && node spec/lib/cli/meso-print.js",
    "meso-trace": "tsc -b && cd .. && node spec/lib/cli/meso-trace.js",
    "meso-query": "tsc -b && cd .. && node spec/lib/cli/meso-query.js --base spec/src"
  },
  "dependencies": {
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/typescript6": "catalog:",
    "typescript": "catalog:"
  }
}
