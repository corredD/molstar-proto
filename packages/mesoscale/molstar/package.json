{
  "name": "@molstar/meso-molstar",
  "version": "6.0.0-dev.0",
  "private": true,
  "type": "module",
  "description": "MesoViewSpec prototype: the Mol*/Prism renderer adapter, the MolViewSpec export, its stories",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "molstar-src": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./prism-viewer": {
      "molstar-src": "./src/prism-viewer.ts",
      "types": "./lib/prism-viewer.d.ts",
      "import": "./lib/prism-viewer.js"
    },
    "./_test/*": null,
    "./_stories/*": null
  },
  "files": [
    "lib",
    "src",
    "!**/_test/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "test:scaling": "vitest run --config vitest.scaling.config.ts",
    "typecheck": "tsc -b",
    "typecheck:storybook": "tsc -p tsconfig.storybook.json"
  },
  "dependencies": {
    "@molstar/core": "workspace:*",
    "@molstar/meso-spec": "workspace:*",
    "@molstar/mesoscale-extension": "workspace:*",
    "@molstar/model": "workspace:*",
    "@molstar/mvs-builder": "workspace:*",
    "@molstar/plugin": "workspace:*",
    "@molstar/prism-viewer": "workspace:*",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@molstar/graphics": "workspace:*",
    "@molstar/plugin-headless": "workspace:*",
    "@molstar/prism-me-app": "workspace:*",
    "@molstar/prism-ui": "workspace:*",
    "@molstar/test-harness": "workspace:*",
    "@storybook/web-components-vite": "catalog:",
    "@types/gl": "catalog:",
    "@types/node": "catalog:",
    "@types/webxr": "catalog:",
    "typescript": "catalog:"
  }
}
