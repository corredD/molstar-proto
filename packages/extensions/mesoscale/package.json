{
  "name": "@molstar/mesoscale-extension",
  "version": "6.0.0-dev.0",
  "private": true,
  "type": "module",
  "description": "Mol* mesoscale-extension: mesoscale models (cellPACK, PetWorld) as particles in the Prism viewer: entities, colors, graphics modes, examples",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    "./controls": {
      "molstar-src": "./src/controls.tsx",
      "types": "./lib/controls.d.ts",
      "import": "./lib/controls.js"
    },
    "./*": {
      "molstar-src": "./src/*.ts",
      "types": "./lib/*.d.ts",
      "import": "./lib/*.js"
    },
    "./_test/*": null,
    "./prism-viewer-ui": null
  },
  "files": [
    "lib",
    "src",
    "!**/_test/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "styles": "node ../../prism/ui/scripts/css.mjs --root . --prefix mesoscale",
    "styles:check": "node ../../prism/ui/scripts/css.mjs --root . --prefix mesoscale --check",
    "test:scaling": "vitest run --config vitest.scaling.config.ts"
  },
  "dependencies": {
    "tslib": "catalog:",
    "@molstar/core": "workspace:*",
    "@molstar/model": "workspace:*",
    "@molstar/graphics": "workspace:*",
    "@molstar/plugin": "workspace:*",
    "@molstar/prism-viewer": "workspace:*",
    "@molstar/prism-ui": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@types/webxr": "catalog:",
    "vitest": "catalog:"
  }
}
