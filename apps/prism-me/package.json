{
  "name": "@molstar/prism-me-app",
  "version": "6.0.0-dev.0",
  "private": true,
  "type": "module",
  "description": "Mol* Prism Mesoscale Explorer: mesoscale models and cryo-ET data (tomograms, particle lists, segmentations) on Prism",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    "./*": {
      "molstar-src": "./src/*.ts",
      "types": "./lib/*.d.ts",
      "import": "./lib/*.js"
    },
    "./_test/*": null
  },
  "scripts": {
    "build": "node ../../scripts/esbuild/app.mjs apps/prism-me --prd",
    "typecheck": "tsc -b",
    "dev": "node ../../scripts/esbuild/app.mjs apps/prism-me --dev"
  },
  "dependencies": {
    "@molstar/core": "workspace:*",
    "@molstar/plugin": "workspace:*",
    "@molstar/prism-assistant": "workspace:*",
    "@molstar/prism-viewer": "workspace:*",
    "@molstar/prism-viewer-app": "workspace:*",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/webxr": "catalog:",
    "typescript": "catalog:"
  },
  "molstar": {
    "entry": "src/index.ts",
    "format": "esm",
    "filename": "index.js",
    "budgets": {
      "index.js": 3400000
    }
  }
}
