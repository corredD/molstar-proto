{
  "name": "@molstar/prism-me-app",
  "version": "6.0.0-dev.0",
  "private": true,
  "type": "module",
  "description": "Mol* Prism Mesoscale Explorer: mesoscale models and cryo-ET data (tomograms, particle lists, segmentations) on Prism",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    "./*": {
      "molstar-src": "./src/*.ts",
      "types": "./lib/*.d.ts",
      "import": "./lib/*.js"
    },
    "./_test/*": null
  },
  "scripts": {
    "build": "node ../../scripts/esbuild/app.mjs apps/prism-me --prd",
    "typecheck": "tsc -b",
    "dev": "node ../../scripts/esbuild/app.mjs apps/prism-me --dev",
    "styles": "node ../../packages/prism/ui/scripts/css.mjs --root . --prefix me",
    "styles:check": "node ../../packages/prism/ui/scripts/css.mjs --root . --prefix me --check",
    "typecheck:storybook": "tsc -p tsconfig.storybook.json",
    "test:scaling": "vitest run --config vitest.scaling.config.ts"
  },
  "dependencies": {
    "@molstar/core": "workspace:*",
    "@molstar/cryoet-extension": "workspace:*",
    "@molstar/graphics": "workspace:*",
    "@molstar/mesoscale-extension": "workspace:*",
    "@molstar/model": "workspace:*",
    "@molstar/plugin": "workspace:*",
    "@molstar/prism-assistant": "workspace:*",
    "@molstar/prism-ui": "workspace:*",
    "@molstar/prism-viewer": "workspace:*",
    "@molstar/prism-viewer-app": "workspace:*",
    "@molstar/stage-tools-extension": "workspace:*",
    "rxjs": "catalog:",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@storybook/web-components-vite": "catalog:",
    "@types/node": "catalog:",
    "@types/webxr": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:"
  },
  "molstar": {
    "entry": "src/index.ts",
    "format": "esm",
    "filename": "index.js",
    "budgets": {
      "index.js": 3400000
    }
  }
}
